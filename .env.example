# ---------------------------------------------------------------------------
# 3CX Configuration API (provisioning API — serves the BDE roster)
# ---------------------------------------------------------------------------
THREECX_API_BASE=https://dotmappers.3cx.in:5001
THREECX_CLIENT_ID=                 # Service Principal id
THREECX_CLIENT_SECRET=             # Service Principal secret
# Set to false ONLY for a lab box with a self-signed cert you trust.
THREECX_VERIFY_TLS=true

# ---------------------------------------------------------------------------
# 3CX database (READ-ONLY user) — confirm host/port/dbname/credentials in Phase B
# ---------------------------------------------------------------------------
SOURCE_DB_DSN=postgresql://ro_user:CHANGEME@DB_HOST:5432/THREECX_DB?sslmode=require

# ---------------------------------------------------------------------------
# Analytics database (the team's own Railway Postgres — all analytics live here)
# ---------------------------------------------------------------------------
ANALYTICS_DB_DSN=postgresql://user:CHANGEME@analytics-host:5432/funnel

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai                # openai | anthropic
LLM_API_KEY=
LLM_MODEL_CHEAP=                   # small/cheap model string (first pass) — set current model
LLM_MODEL_STRONG=                  # stronger model string (escalation) — set current model
CONFIDENCE_THRESHOLD=0.7           # below this on a quality stage -> needs_human_review + escalate
LLM_MAX_TRANSCRIPT_CHARS=24000     # truncate very long transcripts before sending to the LLM

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
BACKFILL_START=                    # earliest call date 'YYYY-MM-DD' (blank = auto-detect min from CDR)
DAILY_LOOKBACK_DAYS=3              # re-sweep window for late transcripts
RPC_MIN_TALK_SECONDS=25            # CDR connected-proxy threshold
TZ=Australia/Melbourne

# In-scope roster rule (Phase D). One of:
#   ROSTER_INSCOPE_GROUPS=Sales,BDE          # group/department names that count as sales BDEs
#   ROSTER_INSCOPE_EXTENSIONS=101,105,107    # explicit allow-list of extensions
# If both are blank, everyone is synced with in_scope=false until reviewed.
ROSTER_INSCOPE_GROUPS=
ROSTER_INSCOPE_EXTENSIONS=

# ---------------------------------------------------------------------------
# 3CX DB schema mapping (filled from Phase B discovery — SCHEMA_NOTES.md)
# Defaults below are the documented V20 U6+ shape; OVERRIDE after discover-schema.
# ---------------------------------------------------------------------------
CDR_TABLE=cdr_output
# Column names in cdr_output — override with the real ones found in Phase B.
CDR_COL_CALL_ID=call_id
CDR_COL_EXTENSION=src_extension
CDR_COL_DIRECTION=direction
CDR_COL_DEST_NUMBER=dst_number
CDR_COL_STARTED_AT=start_time
CDR_COL_RING_SECONDS=ringing_dur
CDR_COL_TALK_SECONDS=talking_dur
CDR_COL_DISPOSITION=termination_reason
CDR_OUTBOUND_VALUE=Outbound        # value of the direction column that means outbound

# Transcript source — confirm table/columns in Phase B.
TRANSCRIPT_TABLE=
TRANSCRIPT_COL_CALL_ID=
TRANSCRIPT_COL_TEXT=
TRANSCRIPT_COL_SENTIMENT=
TRANSCRIPT_COL_SUMMARY=
TRANSCRIPT_COL_DIARIZED=

# ---------------------------------------------------------------------------
# Optional report email (Phase I) — leave blank to disable
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=
